<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(SolutionDir)common\vsprops\BaseProjectConfig.props" />
  <Import Project="$(SolutionDir)common\vsprops\WinSDK.props" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>d5e9deea-2732-4851-8b04-9b77593ff2a5</ProjectGuid>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset Condition="!$(Configuration.Contains(Clang))">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="$(Configuration.Contains(Clang))">ClangCL</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <WholeProgramOptimization Condition="$(Configuration.Contains(Release))">true</WholeProgramOptimization>
    <UseDebugLibraries Condition="$(Configuration.Contains(Debug))">true</UseDebugLibraries>
    <UseDebugLibraries Condition="!$(Configuration.Contains(Debug))">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="..\DefaultProjectRootDir.props" />
    <Import Project="..\3rdparty.props" />
    <Import Condition="$(Configuration.Contains(Debug))" Project="..\..\common\vsprops\CodeGen_Debug.props" />
    <Import Condition="$(Configuration.Contains(Devel))" Project="..\..\common\vsprops\CodeGen_Devel.props" />
    <Import Condition="$(Configuration.Contains(Release))" Project="..\..\common\vsprops\CodeGen_Release.props" />
    <Import Condition="!$(Configuration.Contains(Release))" Project="..\..\common\vsprops\IncrementalLinking.props" />
  </ImportGroup>
  <PropertyGroup>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <ClInclude Include="GLSL.std.450.h" />
    <ClInclude Include="spirv_common.hpp" />
    <ClInclude Include="spirv_cross_containers.hpp" />
    <ClInclude Include="spirv_cross_error_handling.hpp" />
    <ClInclude Include="spirv.hpp" />
    <ClInclude Include="spirv_cross.hpp" />
    <ClInclude Include="spirv_parser.hpp" />
    <ClInclude Include="spirv_cross_parsed_ir.hpp" />
    <ClInclude Include="spirv_cfg.hpp" />
    <ClInclude Include="spirv_glsl.hpp" />
    <ClInclude Include="spirv_hlsl.hpp" />
    <ClInclude Include="spirv_msl.hpp" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="spirv_cross.cpp" />
    <ClCompile Include="spirv_parser.cpp" />
    <ClCompile Include="spirv_cross_parsed_ir.cpp" />
    <ClCompile Include="spirv_cfg.cpp" />
    <ClCompile Include="spirv_glsl.cpp" />
    <ClCompile Include="spirv_hlsl.cpp" />
    <ClCompile Include="spirv_msl.cpp">
      <ExcludedFromBuild>true</ExcludedFromBuild>
    </ClCompile>
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <AdditionalIncludeDirectories>$(ProjectDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>